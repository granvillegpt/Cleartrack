rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // PRODUCTION MODE: UNRESTRICTED ACCESS (DISABLED)
    // ============================================
    // This configuration has been disabled in favor of security rules.
    // Security rules are now active to enforce wizard, escalation, and admin resolution.
    // ============================================
    /*
    // Allow all authenticated users full access to all collections
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Allow unauthenticated access to practitioner applications (for registration)
    match /practitionerApplications/{applicationId} {
      allow read, write: if true;
    }
    
    // Allow unauthenticated access to practitioner invites (for token-based access)
    match /practitionerInvites/{inviteId} {
      allow read, write: if true;
    }
    */
    
    // ============================================
    // SECURITY RULES - ACTIVE
    // Enforces wizard, escalation, and admin resolution server-side
    // ============================================
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function userRole(uid) {
      let doc = userDoc(uid);
      return doc != null && doc.exists ? doc.data.role : null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Helper function to check if a field is restricted for user writes
    function isRestrictedConnectionField(fieldName) {
      return fieldName in ['connectionStatus', 'connectionResolved', 
                           'adminResolvedBy', 'adminResolvedAt', 
                           'adminResolutionNote', 'connectionEscalatedToAdmin'];
    }

    // USERS
    match /users/{uid} {
      // Read: user can read own doc, admin can read all
      allow read: if isOwner(uid) || isAdmin();

      // Create: user can create their own doc with role='user', admin can create any
      allow create: if 
        isAdmin() ||
        (isOwner(uid) && 
         (!('role' in request.resource.data) || request.resource.data.role == 'user'));

      // Update: 
      // - Admin can write anything
      // - User can update own profile EXCEPT restricted connection/admin fields
      // - Practitioner can write connectedPractitioner and practitionerId ONLY
      allow update: if
        isAdmin() || // Admin can write anything
        (
          isOwner(uid) && // User updating own profile
          // Check that no restricted fields are being set to restricted values
          !('connectionStatus' in request.resource.data.diff(resource.data).changedKeys() && 
            (request.resource.data.connectionStatus == 'approved' || 
             request.resource.data.connectionStatus == 'escalated')) &&
          !('connectionResolved' in request.resource.data.diff(resource.data).changedKeys() && 
            request.resource.data.connectionResolved == true) &&
          !('adminResolvedBy' in request.resource.data.diff(resource.data).changedKeys()) &&
          !('adminResolvedAt' in request.resource.data.diff(resource.data).changedKeys()) &&
          !('adminResolutionNote' in request.resource.data.diff(resource.data).changedKeys()) &&
          !('connectionEscalatedToAdmin' in request.resource.data.diff(resource.data).changedKeys()) &&
          // Also preserve existing role restriction
          (!resource.exists || !('role' in request.resource.data.diff(resource.data).changedKeys()))
        ) ||
        (
          // Practitioner can only write connectedPractitioner and practitionerId
          isSignedIn() && 
          userRole(request.auth.uid) == "practitioner" &&
          // Check that no restricted fields are being changed
          !('connectionStatus' in request.resource.data.diff(resource.data).changedKeys()) &&
          !('connectionResolved' in request.resource.data.diff(resource.data).changedKeys()) &&
          !('adminResolvedBy' in request.resource.data.diff(resource.data).changedKeys()) &&
          !('adminResolvedAt' in request.resource.data.diff(resource.data).changedKeys()) &&
          !('adminResolutionNote' in request.resource.data.diff(resource.data).changedKeys()) &&
          !('connectionEscalatedToAdmin' in request.resource.data.diff(resource.data).changedKeys()) &&
          !('role' in request.resource.data.diff(resource.data).changedKeys())
        );

      // Delete: only admin
      allow delete: if isAdmin();
    }

    // Subcollections under /users/{uid}
    match /users/{uid}/{subpath=**} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    // Practitioner applications - anyone can create (no auth required)
    // Authenticated users can read to check if their application is approved
    // Admin can read, update, delete all
    match /practitionerApplications/{applicationId} {
      allow create: if true;
      // Allow authenticated users to read (needed for login to check approved status)
      // Admin can do everything
      allow read: if isSignedIn() || isAdmin();
      allow update, delete: if isAdmin();
    }

    // Practitioner invites - admin can create, anyone can read with token
    match /practitionerInvites/{inviteId} {
      allow create: if isAdmin();
      allow read: if true; // Token-based access handled in function
    }

    // Client invites - practitioners can create, users can read their own
    match /clientInvites/{inviteId} {
      allow create: if isSignedIn() && userRole(request.auth.uid) == "practitioner";
      allow read: if isSignedIn() && (
        userRole(request.auth.uid) == "practitioner" || 
        isAdmin() ||
        (resource.data.clientUid != null && resource.data.clientUid == request.auth.uid)
      );
      allow update: if isSignedIn() && (
        userRole(request.auth.uid) == "practitioner" ||
        isAdmin() ||
        (resource.data.clientUid != null && resource.data.clientUid == request.auth.uid)
      );
    }

    // Client requests - clients can create, practitioners can read assigned ones, admin can read all
    match /clientRequests/{requestId} {
      allow create: if isSignedIn(); // Any authenticated user can create a request
      allow read: if isSignedIn() && (
        isAdmin() ||
        (resource.data.clientUid == request.auth.uid) ||
        (resource.data.assignedPractitionerId == request.auth.uid && userRole(request.auth.uid) == "practitioner")
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        (resource.data.assignedPractitionerId == request.auth.uid && userRole(request.auth.uid) == "practitioner")
      );
    }

    // Connections - users can read their own connections, practitioners can read connections to them
    match /connections/{connectionId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid) ||
        (resource.data.practitionerId == request.auth.uid)
      );
      allow create: if isSignedIn() && (
        isAdmin() ||
        (request.resource.data.userId == request.auth.uid) ||
        (request.resource.data.practitionerId == request.auth.uid)
      );
      allow update, delete: if isSignedIn() && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid) ||
        (resource.data.practitionerId == request.auth.uid)
      );
    }

    // Connection requests - users can create, practitioners can read/update their requests
    // Users CANNOT update their own requests (cannot self-approve)
    match /connectionRequests/{requestId} {
      allow create: if isSignedIn() && (
        isAdmin() ||
        (request.resource.data.userId == request.auth.uid)
      );
      allow read: if isSignedIn() && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid) ||
        (resource.data.practitionerId == request.auth.uid)
      );
      allow update: if isSignedIn() && (
        isAdmin() || // Admin can do everything
        (
          // Practitioner can only update status field to approved/rejected
          userRole(request.auth.uid) == "practitioner" &&
          resource.data.practitionerId == request.auth.uid &&
          // Status must be approved or rejected (or unchanged)
          (request.resource.data.status == 'approved' || 
           request.resource.data.status == 'rejected' ||
           request.resource.data.status == resource.data.status) &&
          // Check that no disallowed fields are being changed (allow status, updatedAt, rejectedAt, approvedAt, rejectionNumber, rejectedBy)
          !('userId' in request.resource.data.diff(resource.data).changedKeys()) &&
          !('practitionerId' in request.resource.data.diff(resource.data).changedKeys())
        )
      );
      // Users cannot update their own requests
    }

    // Tax returns - practitioners can read/write their tax returns, users can read their own
    match /taxReturns/{taxReturnId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid) ||
        (resource.data.practitionerId == request.auth.uid)
      );
      allow create: if isSignedIn() && (
        isAdmin() ||
        (request.resource.data.practitionerId == request.auth.uid)
      );
      allow update, delete: if isSignedIn() && (
        isAdmin() ||
        (resource.data.practitionerId == request.auth.uid)
      );
    }

    // Invoices - practitioners can read/write their invoices, users can read their own
    match /invoices/{invoiceId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid) ||
        (resource.data.practitionerId == request.auth.uid)
      );
      allow create: if isSignedIn() && (
        isAdmin() ||
        (request.resource.data.practitionerId == request.auth.uid)
      );
      allow update, delete: if isSignedIn() && (
        isAdmin() ||
        (resource.data.practitionerId == request.auth.uid)
      );
    }

    // Messages - users and practitioners can read/write their messages
    match /messages/{messageId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid) ||
        (resource.data.practitionerId == request.auth.uid)
      );
      allow create: if isSignedIn() && (
        isAdmin() ||
        (request.resource.data.userId == request.auth.uid) ||
        (request.resource.data.practitionerId == request.auth.uid)
      );
      allow update, delete: if isSignedIn() && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid) ||
        (resource.data.practitionerId == request.auth.uid)
      );
    }

    // Everything else: closed by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
