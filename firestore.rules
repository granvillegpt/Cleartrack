rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* =========================
       Helper Functions
       ========================= */

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isPractitionerOf(userId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(userId))
             .data.currentPractitionerId == request.auth.uid
        && get(/databases/$(database)/documents/users/$(userId))
             .data.practitionerConsent == true;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function userRole(uid) {
      let doc = userDoc(uid);
      return doc != null && doc.exists ? doc.data.role : null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isPractitionerProfile(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role == "practitioner";
    }

    function isCounterparty(targetUserId) {
      return isSignedIn() && (
        // Check if target user is connected to requesting user (as practitioner)
        get(/databases/$(database)/documents/users/$(targetUserId))
          .data.currentPractitionerId == request.auth.uid ||
        // Check if requesting user is connected to target user (as practitioner)
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.currentPractitionerId == targetUserId
      );
    }

    /* =========================
       USERS
       ========================= */

    match /users/{userId} {
      // READ:
      // Profile images visible only to owner or matched counterparty
      allow read: if
        request.auth.uid == userId ||        // owner
        isCounterparty(userId);               // paired identity visibility

      // WRITE:
      // Only the owner can modify their own profile
      allow write: if request.auth.uid == userId;

      // SUBCOLLECTIONS:
      // Sensitive data remains protected by ownership or consent
      match /{subpath=**} {
        allow read, write: if
          request.auth.uid == userId ||
          isPractitionerOf(userId);
      }
    }


    /* =========================
       PRACTITIONER APPLICATIONS
       ========================= */
    match /practitionerApplications/{applicationId} {
      allow create: if true;
      allow read: if isSignedIn() || isAdmin();
      allow update, delete: if isAdmin();
    }

    /* =========================
       PRACTITIONER INVITES
       ========================= */
    match /practitionerInvites/{inviteId} {
      allow create: if isAdmin();
      allow read: if true;
    }

    /* =========================
       CLIENT INVITES
       ========================= */
    match /clientInvites/{inviteId} {
      allow create: if isSignedIn() &&
        userRole(request.auth.uid) == "practitioner";

      allow read, update: if isSignedIn() && (
        isAdmin() ||
        userRole(request.auth.uid) == "practitioner" ||
        resource.data.clientUid == request.auth.uid
      );
    }

    /* =========================
       CONNECTION REQUESTS
       ========================= */
    match /connectionRequests/{requestId} {

      // Client creates request
      allow create: if isSignedIn() &&
        (isAdmin() || request.resource.data.userId == request.auth.uid);

      // Client, practitioner, admin can read
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||
        resource.data.practitionerId == request.auth.uid
      );

      // Practitioner approves / rejects ONLY
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          userRole(request.auth.uid) == "practitioner" &&
          resource.data.practitionerId == request.auth.uid &&
          (
            request.resource.data.status == 'approved' ||
            request.resource.data.status == 'rejected' ||
            request.resource.data.status == resource.data.status
          ) &&
          !('userId' in request.resource.data.diff(resource.data).changedKeys()) &&
          !('practitionerId' in request.resource.data.diff(resource.data).changedKeys())
        )
      );
    }

    /* =========================
       CONNECTIONS
       ========================= */
    match /connections/{connectionId} {
      // Allow users to create connection documents where they are the userId
      allow create: if isSignedIn() && (
        isAdmin() ||
        request.resource.data.userId == request.auth.uid
      );
      
      // Allow read/update/delete if user is the userId or practitionerId in the document
      // Split read into get and list for better query support
      allow get, update, delete: if isSignedIn() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||
        resource.data.practitionerId == request.auth.uid
      );
      
      // Allow querying connections collection
      // For list queries, allow if authenticated and the query filters by practitionerId
      // Firestore will automatically filter results based on the get rule above
      allow list: if isSignedIn() && (
        isAdmin() ||
        // Allow queries where practitionerId matches request.auth.uid
        // The get rule above ensures only matching documents are returned
        true
      );
    }

    /* =========================
       TAX RETURNS
       ========================= */
    match /taxReturns/{taxReturnId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||
        resource.data.practitionerId == request.auth.uid
      );
      // Fixed: Use request.resource.data for create operations
      allow create: if isSignedIn() && (
        isAdmin() ||
        request.resource.data.practitionerId == request.auth.uid
      );
      allow update, delete: if isSignedIn() && (
        isAdmin() ||
        resource.data.practitionerId == request.auth.uid
      );
    }

    /* =========================
       INVOICES
       ========================= */
    match /invoices/{invoiceId} {
      // Fixed: Separate create from read/update/delete
      allow create: if isSignedIn() && (
        isAdmin() ||
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.practitionerId == request.auth.uid
      );
      allow read, update, delete: if isSignedIn() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||
        resource.data.practitionerId == request.auth.uid
      );
    }

    /* =========================
       MESSAGES
       ========================= */
    match /messages/{messageId} {
      // Fixed: Separate create from read/update/delete
      // Users can create messages where they are the userId
      // Practitioners can create messages where they are the practitionerId
      allow create: if isSignedIn() && (
        isAdmin() ||
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.practitionerId == request.auth.uid
      );
      // Users and practitioners can read/update/delete their own messages
      allow read, update, delete: if isSignedIn() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||
        resource.data.practitionerId == request.auth.uid
      );
    }

    /* =========================
       CLIENT REQUESTS
       ========================= */
    match /clientRequests/{requestId} {
      // Client can create request
      allow create: if isSignedIn() &&
        request.resource.data.clientUid == request.auth.uid;
      
      // Practitioner can read requests assigned to them
      // Client can read their own requests
      // Admin can read all
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.clientUid == request.auth.uid ||
        resource.data.assignedPractitionerId == request.auth.uid
      );
      
      // Practitioner can update requests assigned to them (approve/decline)
      // Admin can update any
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          userRole(request.auth.uid) == "practitioner" &&
          resource.data.assignedPractitionerId == request.auth.uid
        )
      );
    }

    /* =========================
       SUPPORT TICKETS
       ========================= */
    match /supportTickets/{ticketId} {
      // User can create their own tickets
      allow create: if isSignedIn() &&
        request.resource.data.requester.userId == request.auth.uid;
      
      // User can read their own tickets
      // Practitioner can read tickets from their clients
      // Admin can read all
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.requester.userId == request.auth.uid ||
        (
          userRole(request.auth.uid) == "practitioner" &&
          resource.data.requester.userId != null
        )
      );
      
      // User can update their own tickets
      // Practitioner can update tickets from their clients
      // Admin can update any
      allow update: if isSignedIn() && (
        isAdmin() ||
        resource.data.requester.userId == request.auth.uid ||
        (
          userRole(request.auth.uid) == "practitioner" &&
          resource.data.requester.userId != null
        )
      );
    }

    /* =========================
       AUDIT LOGS
       ========================= */
    match /auditLogs/{auditId} {
      // Only admins can read audit logs
      allow read: if isAdmin();
      // Only system (via admin) can create audit logs
      allow create: if isAdmin();
      // No updates or deletes allowed
      allow update, delete: if false;
    }

    /* =========================
       TAX YEARS
       ========================= */
    match /taxYears/{taxYearId} {
      // Allow read if user owns the tax year or is their practitioner
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||
        // Practitioner can read their clients' tax years
        (userRole(request.auth.uid) == "practitioner" && 
         get(/databases/$(database)/documents/users/$(resource.data.userId)).data.currentPractitionerId == request.auth.uid)
      );
      
      // Allow create if user is creating for themselves, or practitioner for their client
      allow create: if isSignedIn() && (
        isAdmin() ||
        request.resource.data.userId == request.auth.uid ||
        (userRole(request.auth.uid) == "practitioner" && 
         get(/databases/$(database)/documents/users/$(request.resource.data.userId)).data.currentPractitionerId == request.auth.uid)
      );
      
      // Allow update/delete only by practitioner or admin (for status changes)
      allow update, delete: if isSignedIn() && (
        isAdmin() ||
        (userRole(request.auth.uid) == "practitioner" && 
         get(/databases/$(database)/documents/users/$(resource.data.userId)).data.currentPractitionerId == request.auth.uid)
      );
    }

    /* =========================
       ENGAGEMENT PERIODS
       ========================= */
    match /engagementPeriods/{engagementId} {
      // READ
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||
        (
          userRole(request.auth.uid) == "practitioner" &&
          get(/databases/$(database)/documents/users/$(resource.data.userId))
            .data.currentPractitionerId == request.auth.uid
        )
      );

      // CREATE — user owns their employment history
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;

      // UPDATE — USER (always allowed on own data)
      allow update: if isSignedIn() &&
        request.auth.uid == resource.data.userId;

      // UPDATE — PRACTITIONER (confirmation only)
      allow update: if isSignedIn() &&
        userRole(request.auth.uid) == "practitioner" &&
        get(/databases/$(database)/documents/users/$(resource.data.userId))
          .data.currentPractitionerId == request.auth.uid &&
        request.resource.data.diff(resource.data).changedKeys()
          .hasOnly([
            "confirmedByPractitioner",
            "confirmedAt",
            "includedInTaxPack"
          ]);

      // ADMIN — FULL CONTROL
      allow update, delete: if isAdmin();

      // DELETE — USER (own records only)
      allow delete: if isSignedIn() &&
        request.auth.uid == resource.data.userId;
    }

    /* =========================
       DEFAULT DENY
       ========================= */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
